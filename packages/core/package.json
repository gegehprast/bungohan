{
  "name": "@bungohan/core",
  "version": "0.1.0-alpha.1",
  "description": "Authoritative multiplayer game server for Bun: rooms, matchmaking, state sync and clustering",
  "keywords": [
    "bungohan",
    "multiplayer",
    "game-server",
    "realtime",
    "authoritative",
    "rooms",
    "matchmaking",
    "bun"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gegehprast/bungohan/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gegehprast/bungohan.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gegehprast/bungohan/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun ../../scripts/guard-publish.ts"
  },
  "dependencies": {
    "@bungohan/backplane": "workspace:*",
    "@bungohan/result": "workspace:*",
    "@bungohan/schema": "workspace:*",
    "@bungohan/serializer": "workspace:*",
    "@bungohan/store": "workspace:*",
    "@bungohan/transport": "workspace:*",
    "@bungohan/types": "workspace:*",
    "nanoid": "catalog:"
  },
  "peerDependencies": {
    "@bungohan/state": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@bungohan/state": "workspace:*"
  }
}
