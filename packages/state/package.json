{
  "name": "@bungohan/state",
  "version": "0.1.0-alpha.5",
  "description": "Schema-based game state for Bungohan, synced to clients as compact binary deltas",
  "keywords": [
    "bungohan",
    "multiplayer",
    "game-server",
    "realtime",
    "state-sync",
    "delta-encoding",
    "schema",
    "binary"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gegehprast/bungohan/tree/main/packages/state#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gegehprast/bungohan.git",
    "directory": "packages/state"
  },
  "bugs": {
    "url": "https://github.com/gegehprast/bungohan/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun ../../scripts/guard-publish.ts"
  },
  "dependencies": {
    "@bungohan/result": "workspace:*",
    "@bungohan/types": "workspace:*",
    "nanoid": "catalog:"
  },
  "devDependencies": {
    "@msgpack/msgpack": "catalog:"
  }
}
