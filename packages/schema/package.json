{
  "name": "@bungohan/schema",
  "version": "0.1.0-alpha.3",
  "description": "Bungohan's shared definitions: state schemas and message contracts, importable from both the server and the browser",
  "keywords": [
    "bungohan",
    "multiplayer",
    "game-server",
    "realtime",
    "schema",
    "contract",
    "shared",
    "browser"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gegehprast/bungohan/tree/main/packages/schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gegehprast/bungohan.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/gegehprast/bungohan/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun ../../scripts/guard-publish.ts"
  },
  "dependencies": {
    "@bungohan/types": "workspace:*"
  },
  "peerDependencies": {
    "@bungohan/state": "0.1.0-alpha.3"
  },
  "devDependencies": {
    "@bungohan/state": "workspace:*"
  }
}
