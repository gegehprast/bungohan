{
  "name": "@bungohan/transport",
  "version": "0.1.0-alpha.3",
  "description": "WebSocket transport for Bungohan servers, built on Bun.serve()",
  "keywords": [
    "bungohan",
    "multiplayer",
    "game-server",
    "realtime",
    "websocket",
    "transport",
    "bun"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gegehprast/bungohan/tree/main/packages/transport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gegehprast/bungohan.git",
    "directory": "packages/transport"
  },
  "bugs": {
    "url": "https://github.com/gegehprast/bungohan/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun ../../scripts/guard-publish.ts"
  },
  "dependencies": {
    "@bungohan/result": "workspace:*",
    "nanoid": "catalog:"
  }
}
