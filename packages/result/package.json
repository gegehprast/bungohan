{
  "name": "@bungohan/result",
  "version": "0.1.0-alpha.4",
  "description": "Result<T, E> for Bungohan: operations that can fail return a value, not a thrown exception",
  "keywords": [
    "bungohan",
    "multiplayer",
    "game-server",
    "realtime",
    "result",
    "either",
    "error-handling"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gegehprast/bungohan/tree/main/packages/result#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gegehprast/bungohan.git",
    "directory": "packages/result"
  },
  "bugs": {
    "url": "https://github.com/gegehprast/bungohan/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun ../../scripts/guard-publish.ts"
  }
}
