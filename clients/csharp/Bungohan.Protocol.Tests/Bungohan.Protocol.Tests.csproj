<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test runner for the protocol core: the conformance vectors
    (conformance/v1), replica tests, and the recorded shooter stream applied
    through the generated bindings. A console app with no packages:
    dotnet run (project clients/csharp/Bungohan.Protocol.Tests).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Bungohan.Protocol/Bungohan.Protocol.csproj" />
    <ProjectReference Include="../Bungohan.Bindings/Bungohan.Bindings.csproj" />
  </ItemGroup>

</Project>
